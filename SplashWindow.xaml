<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FluentScrobbler.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
            <Grid Padding="36">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                    <Border Width="96" Height="96" CornerRadius="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="10">
                        <Image Source="ms-appx:///Assets/Square150x150Logo.scale-200.png" Stretch="Uniform" />
                    </Border>
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="Fluent Scrobbler" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Text="v0.1.0" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="12">
                    <ProgressBar x:Name="SplashProgressBar" IsIndeterminate="True" Height="3" CornerRadius="1.5" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <Grid>
                        <TextBlock x:Name="StatusText" Text="Initializing application..." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Left" />
                        <TextBlock Text="MSI Scrobbler Engine" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" FontSize="10" Opacity="0.5" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
