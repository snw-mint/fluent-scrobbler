<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FluentScrobbler.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentScrobbler"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36">
        <StackPanel Spacing="24" MaxWidth="600" HorizontalAlignment="Left">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <Border Width="80" Height="80" CornerRadius="16" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="8">
                        <Image Source="ms-appx:///Assets/Square150x150Logo.scale-200.png" Stretch="Uniform" />
                    </Border>

                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="Fluent Scrobbler" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Text="Version 0.1 (WinUI 3 / .NET 8)" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="A modern, lightweight scrobbler for Windows inspired by Pano Scrobbler and Windows Fluent Design." Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Spacing="12">
                <TextBlock Text="Application Info" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Text="Framework" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="Windows App SDK 1.5 / WinUI 3" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <MenuFlyoutSeparator />
                        <Grid>
                            <TextBlock Text="Runtime Target" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <TextBlock Text=".NET 8.0 (win-x64)" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <MenuFlyoutSeparator />
                        <Grid>
                            <TextBlock Text="Backdrop Material" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="Windows 11 Mica" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
