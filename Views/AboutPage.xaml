<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FluentScrobbler.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentScrobbler"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24">
        <StackPanel Spacing="24" MaxWidth="600" HorizontalAlignment="Center">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                <Grid ColumnSpacing="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="ms-appx:///Assets/logo.png" Width="72" Height="72" Stretch="Uniform" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Fluent Scrobbler" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" />
                        <TextBlock Text="A lightweight, modern Windows scrobbler for Last.fm built with WinUI 3 and Fluent Design." Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Spacing="12">
                <TextBlock Text="Application Info" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Text="App Version" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="AppVersionText" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <Image x:Name="StatusIconImage" Source="ms-appx:///Assets/Status/updated.png" Width="14" Height="14" VerticalAlignment="Center" />
                                <Button x:Name="CheckNowButton"
                                        Content="Check now"
                                        Click="CheckNowButton_Click"
                                        Padding="8,4"
                                        FontSize="12"
                                        VerticalAlignment="Center" />
                                <Button x:Name="UpdateNowButton"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Content="Update Now"
                                        Click="UpdateNowButton_Click"
                                        Visibility="Collapsed"
                                        Padding="10,4"
                                        FontSize="12"
                                        VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <MenuFlyoutSeparator />
                        <Grid>
                            <TextBlock Text="Framework" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="Windows App SDK 1.5 / WinUI 3" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <MenuFlyoutSeparator />
                        <Grid>
                            <TextBlock Text="Runtime Target" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <TextBlock Text=".NET 8.0 (win-x64)" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <MenuFlyoutSeparator />
                        <Grid>
                            <TextBlock Text="Media Detection" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="Windows GSMTC" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <MenuFlyoutSeparator />
                        <Grid>
                            <TextBlock Text="Logs" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <Button x:Name="OpenLogsButton" Click="OpenLogsButton_Click" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ic:SymbolIcon Symbol="Folder" FontSize="16" />
                                    <TextBlock Text="Open Logs" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="Developer &amp; Project" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Text="Developer" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <HyperlinkButton Content="Snow mint" NavigateUri="https://github.com/snw-mint" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <MenuFlyoutSeparator />
                        <Grid>
                            <TextBlock Text="Repository" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <HyperlinkButton Content="snw-mint/fluent-scrobbler" NavigateUri="https://github.com/snw-mint/fluent-scrobbler" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <MenuFlyoutSeparator />
                        <Grid>
                            <TextBlock Text="License" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="GPL-3.0 License" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <MenuFlyoutSeparator />
                        <Button x:Name="OpenLicensesButton" Click="OpenLicensesButton_Click" HorizontalAlignment="Stretch" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <ic:SymbolIcon Symbol="Code" FontSize="16" />
                                <TextBlock Text="Open Source Licenses" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="System Diagnostics" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Text="OS Version" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <TextBlock x:Name="OsVersionText" Text="Loading..." Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <MenuFlyoutSeparator />
                        <Grid>
                            <TextBlock Text="Architecture" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <TextBlock x:Name="ArchitectureText" Text="Loading..." Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <MenuFlyoutSeparator />
                        <Grid>
                            <TextBlock Text=".NET Framework" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <TextBlock x:Name="RuntimeVersionText" Text="Loading..." Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <MenuFlyoutSeparator />
                        <Button x:Name="CopySystemInfoButton" Click="CopySystemInfoButton_Click" HorizontalAlignment="Stretch" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <ic:SymbolIcon Symbol="Copy" FontSize="16" />
                                <TextBlock x:Name="CopyButtonText" Text="Copy System Info for Bug Report" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
