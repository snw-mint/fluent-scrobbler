<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FluentScrobbler.Views.TrayFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ic="using:FluentIcons.WinUI"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="FlyoutOuterBorderBrush" Color="#0FFFFFFF" />
                        <SolidColorBrush x:Key="FlyoutDividerBrush" Color="#0FFFFFFF" />
                        <SolidColorBrush x:Key="FlyoutFooterBackgroundBrush" Color="#10FFFFFF" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="FlyoutOuterBorderBrush" Color="#0FFFFFFF" />
                        <SolidColorBrush x:Key="FlyoutDividerBrush" Color="#0FFFFFFF" />
                        <SolidColorBrush x:Key="FlyoutFooterBackgroundBrush" Color="#10FFFFFF" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="FlyoutOuterBorderBrush" Color="#0F000000" />
                        <SolidColorBrush x:Key="FlyoutDividerBrush" Color="#0F000000" />
                        <SolidColorBrush x:Key="FlyoutFooterBackgroundBrush" Color="#0A000000" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Border x:Name="FlyoutContainer"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource FlyoutOuterBorderBrush}"
                Background="Transparent">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" VerticalAlignment="Top">
                    <StackPanel Padding="14,12,14,10" Spacing="2">
                        <Grid x:Name="TrackTitleViewport"
                              Height="20"
                              HorizontalAlignment="Stretch"
                              SizeChanged="TrackTitleViewport_SizeChanged">
                            <StackPanel x:Name="TrackMarqueePanel"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="TrackTitleText"
                                           Text="No track playing"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                                           FontSize="13"
                                           MaxLines="1"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="TrackTitleDuplicateText"
                                           Text="No track playing"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                                           FontSize="13"
                                           MaxLines="1"
                                           Margin="36,0,0,0"
                                           Visibility="Collapsed"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="ArtistNameText"
                                   Text="Artist"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1" />

                        <TextBlock x:Name="StatusText"
                                   Text="Listening"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1" />
                    </StackPanel>

                    <StackPanel x:Name="ActionsContainer">
                        <Border Height="1"
                                Background="{ThemeResource FlyoutDividerBrush}" />

                        <StackPanel Padding="6,6" Spacing="2">
                            <Button x:Name="LikeTrackButton"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Style="{ThemeResource SubtleButtonStyle}"
                                    Padding="10,7"
                                    CornerRadius="6"
                                    Click="LikeTrackButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <ic:SymbolIcon x:Name="LikeTrackIcon"
                                                   Symbol="Heart"
                                                   IconVariant="Regular"
                                                   FontSize="15"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    <TextBlock Text="Like track"
                                               Style="{ThemeResource BodyTextBlockStyle}"
                                               FontSize="12.5"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="IgnoreTrackButton"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Style="{ThemeResource SubtleButtonStyle}"
                                    Padding="10,7"
                                    CornerRadius="6"
                                    Click="IgnoreTrackButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <ic:SymbolIcon x:Name="IgnoreTrackIcon"
                                                   Symbol="SubtractCircle"
                                                   IconVariant="Regular"
                                                   FontSize="15"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    <TextBlock Text="Ignore track"
                                               Style="{ThemeResource BodyTextBlockStyle}"
                                               FontSize="12.5"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1"
                        Background="{ThemeResource FlyoutFooterBackgroundBrush}"
                        BorderBrush="{ThemeResource FlyoutOuterBorderBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,8,8"
                        Height="40"
                        Padding="12,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Image Source="ms-appx:///Assets/logo.png"
                                   Width="15"
                                   Height="15"
                                   VerticalAlignment="Center" />
                            <TextBlock Text="Fluent Scrobbler"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Button x:Name="SettingsButton"
                                Grid.Column="1"
                                Style="{ThemeResource SubtleButtonStyle}"
                                Width="28"
                                Height="28"
                                Padding="0"
                                MinWidth="0"
                                MinHeight="0"
                                CornerRadius="6"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                ToolTipService.ToolTip="Settings"
                                Click="SettingsButton_Click">
                            <ic:SymbolIcon Symbol="Settings"
                                           FontSize="14"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
