<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FluentScrobbler.Views.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentScrobbler"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ic="using:FluentIcons.WinUI"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24" SizeChanged="ScrollViewer_SizeChanged">
        <StackPanel x:Name="MainContentPanel" Spacing="24" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock Text="Account" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" />
                <TextBlock Text="Manage your profile settings and scrobbler integrations" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="80" Height="80" CornerRadius="40" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Grid>
                            <ic:SymbolIcon x:Name="UserAvatarIcon" Symbol="Person" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <Image x:Name="UserAvatarImage" Width="80" Height="80" Stretch="UniformToFill" Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="AccountTitleText" Text="Login to Lastfm Account" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock x:Name="AccountSubtitleText" Text="Not connected" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AccountDetailsText" Text="" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" TextWrapping="Wrap" />
                    </StackPanel>

                    <Button x:Name="ActionButton" Grid.Column="2" VerticalAlignment="Center" Style="{ThemeResource AccentButtonStyle}" Padding="20,10" Click="OnActionButtonClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="ActionButtonRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                            <ic:SymbolIcon x:Name="ActionButtonIcon" Symbol="Open" FontSize="16" />
                            <TextBlock x:Name="ActionButtonText" Text="Login" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ic:SymbolIcon Grid.Column="0" Symbol="Key" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Last.fm API Credentials (BYOK)" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" VerticalAlignment="Center" />
                                <Border x:Name="ByokStatusBadge" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="ByokStatusBadgeText" Text="Fallback Active" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="ByokDescriptionText" Text="Starting December 1st, Last.fm requires a Last.fm Pro subscription to hold an API key. Enter your own API Key and Shared Secret below to keep scrobbling." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <HyperlinkButton Grid.Column="2" NavigateUri="https://www.last.fm/api/account/create" VerticalAlignment="Center" ToolTipService.ToolTip="Create a Last.fm API Key (Requires Last.fm Pro)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Get API Key" FontSize="12" />
                                <ic:SymbolIcon Symbol="Open" FontSize="14" />
                            </StackPanel>
                        </HyperlinkButton>
                    </Grid>

                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="CustomApiKeyInput" Grid.Column="0" Header="API Key" PlaceholderText="Paste your 32-character Last.fm API Key" TextChanged="CustomApiInputs_Changed" />
                        <PasswordBox x:Name="CustomApiSecretInput" Grid.Column="1" Header="Shared Secret" PlaceholderText="Paste your 32-character Shared Secret" PasswordChanged="CustomApiInputs_Changed" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="ByokFeedbackText" Grid.Column="0" Text="Requires an active Last.fm Pro account on the key owner profile." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="ClearApiCredentialsButton" Content="Remove Key" Click="ClearApiCredentialsButton_Click" Visibility="Collapsed" />
                            <Button x:Name="SaveApiCredentialsButton" Content="Save Credentials" Style="{ThemeResource AccentButtonStyle}" Click="SaveApiCredentialsButton_Click" IsEnabled="False" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock Text="Local Data &amp; Configuration" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" Margin="0,0,0,4" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ic:SymbolIcon Grid.Column="0" Symbol="CloudSync" FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                            <TextBlock Text="Offline Cache Status" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="OfflineCacheStatusDescription" Text="No scrobbles pending in offline cache." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <Button x:Name="SyncNowButton" Grid.Column="2" Content="Sync Now" VerticalAlignment="Center" Click="SyncNowButton_Click" IsEnabled="False" />
                    </Grid>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ic:SymbolIcon Grid.Column="0" Symbol="Delete" FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                            <TextBlock Text="Clear Offline Cache" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Permanently remove all locally cached scrobbles without submitting them to Last.fm." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <Button x:Name="ClearCacheButton" Grid.Column="2" Content="Clear Cache" VerticalAlignment="Center" Click="ClearCacheButton_Click" />
                    </Grid>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ic:SymbolIcon Grid.Column="0" Symbol="Settings" FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                            <TextBlock Text="Application Settings" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="ConfigBackupDescription" Text="Log in to your account to export or import your application settings." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="ExportConfigButton" Content="Export" VerticalAlignment="Center" Click="ExportConfigButton_Click" IsEnabled="False" />
                            <Button x:Name="ImportConfigButton" Content="Import" VerticalAlignment="Center" Click="ImportConfigButton_Click" IsEnabled="False" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock Text="Privacy &amp; Terms" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" Margin="0,0,0,4" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ic:SymbolIcon Grid.Column="0" Symbol="ShieldCheckmark" FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                            <TextBlock Text="Privacy Policy" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Learn how your credentials and listening history are handled locally." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <HyperlinkButton Grid.Column="2" NavigateUri="https://snw-mint.github.io/fluent-scrobbler/privacy.html" VerticalAlignment="Center" ToolTipService.ToolTip="Open in browser">
                            <ic:SymbolIcon Symbol="Open" FontSize="16" />
                        </HyperlinkButton>
                    </Grid>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ic:SymbolIcon Grid.Column="0" Symbol="DocumentBulletList" FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                            <TextBlock Text="Terms of Service" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Read our usage terms and open-source policies." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <HyperlinkButton Grid.Column="2" NavigateUri="https://snw-mint.github.io/fluent-scrobbler/terms.html" VerticalAlignment="Center" ToolTipService.ToolTip="Open in browser">
                            <ic:SymbolIcon Symbol="Open" FontSize="16" />
                        </HyperlinkButton>
                    </Grid>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
